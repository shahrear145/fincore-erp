# Copy this file to .env and fill in real values.
# NEVER commit the real .env to version control.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated trusted origins for CSRF (falls back to CORS_ALLOWED_ORIGINS).
CSRF_TRUSTED_ORIGINS=

# --- Database (SQLite is used when these variables are EMPTY) ---
# Example for Docker: POSTGRES_DB=postgres, etc.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Celery / Redis (leave REDIS_URL empty to run without async workers) ---
REDIS_URL=

# --- CORS (Flutter dev origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (Gmail SMTP) ---
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# Seconds to wait before giving up on an unreachable SMTP server.
EMAIL_TIMEOUT=10

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# --- S3-compatible storage (Phase 8 backups/files) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
