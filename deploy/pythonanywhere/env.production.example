# FinCore ERP — production .env for PythonAnywhere (free "Beginner" plan)
#
# Copy this file to backend/.env on the server (setup.sh does it for you)
# and replace YOURNAME with your PythonAnywhere username.
#
#   cp deploy/pythonanywhere/env.production.example backend/.env
#   nano backend/.env
#
# NEVER commit the real .env and never share its SECRET_KEY.

# --- Django core -----------------------------------------------------------
DEBUG=False
SECRET_KEY=REPLACE-WITH-A-LONG-RANDOM-STRING
ALLOWED_HOSTS=YOURNAME.pythonanywhere.com

# HTTPS is terminated by PythonAnywhere's proxy; these make CSRF work.
CSRF_TRUSTED_ORIGINS=https://YOURNAME.pythonanywhere.com
CORS_ALLOWED_ORIGINS=https://YOURNAME.pythonanywhere.com

# --- Database (SQLite — keep every POSTGRES_* variable EMPTY) --------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Celery / Redis (none on the free plan — Celery runs inline) -----------
REDIS_URL=

# --- JWT -------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# --- Email -----------------------------------------------------------------
# Free PythonAnywhere accounts may only reach Gmail's SMTP servers (no other
# provider). Use a 16-character Gmail App Password (requires 2-Step
# Verification) — the normal account password will NOT work.
# Wrong/empty credentials show up as "Connection unexpectedly closed".
# Verify with: python manage.py check_email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=

# --- Backups ---------------------------------------------------------------
# Local backups work. S3 uploads need boto3, which is not installed on the
# free plan; leave these empty.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=us-east-1

# --- AI assistant (optional) ----------------------------------------------
# Empty = deterministic engine only, no network calls.
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
